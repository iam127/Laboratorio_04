<Window x:Class="NeptunoWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neptuno - Laboratorio 04" Height="600" Width="950">
    <Grid Margin="10">
        <TabControl>

            <TabItem Header="Productos">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Content="Cargar productos" Width="150" HorizontalAlignment="Left"
                            Click="BtnCargarProductos_Click"/>
                    <DataGrid Grid.Row="1" Name="dgProductos" AutoGenerateColumns="True" Margin="0,10,0,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="Categorías">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Content="Cargar categorías" Width="150" HorizontalAlignment="Left"
                            Click="BtnCargarCategorias_Click"/>
                    <DataGrid Grid.Row="1" Name="dgCategorias" AutoGenerateColumns="True" Margin="0,10,0,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="Proveedores">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="Nombre contacto" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Name="txtContacto" Width="160" Margin="0,0,20,0"/>
                        <TextBlock Text="Ciudad" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Name="txtCiudad" Width="160"/>
                    </StackPanel>

                    <Button Grid.Row="1" Content="Buscar proveedores" Width="160" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Click="BtnBuscarProveedores_Click"/>
                    <DataGrid Grid.Row="2" Name="dgProveedores" AutoGenerateColumns="True" Margin="0,10,0,0"/>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
